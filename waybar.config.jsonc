{
    "layer": "top",
    "position": "top",
    "margin-top": 10,
    "margin-left": 20,
    "margin-right": 20,
    "height": 34,
    "spacing": 10,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["tray"],
    
    "hyprland/workspaces": {
        "format": "{name}",
        "disable-scroll": true
    },
    "clock": {
        "format": "{:%I:%M %p}"
    }
}
